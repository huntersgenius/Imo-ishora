# IMO-ISHORA backend configuration (copy to .env for local development).
# Secrets must never be committed and are never exposed to the frontend.

# --- Application ---
APP_NAME=imo-ishora
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- Cloudflare R2 (required for real synthesis; optional for dev startup) ---
R2_ACCOUNT_ID=
R2_BUCKET=imo-ishora
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Object layout (prefixes). Defaults match the product invariants.
R2_SIGNS_PREFIX=signs/
R2_OUTPUTS_PREFIX=outputs/
R2_MANIFESTS_PREFIX=manifests/

# Playback URL policy. Signed URLs use the R2 S3 API domain (not a custom domain).
R2_USE_SIGNED_URLS=true
R2_SIGNED_URL_EXPIRY_SECONDS=3600
# Set when serving public objects via a custom domain instead of signed URLs.
R2_PUBLIC_BASE_URL=

# --- Video output profile ---
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=30
VIDEO_CODEC=libx264
VIDEO_AUDIO_POLICY=drop
VIDEO_CONTAINER=mp4
VIDEO_PIXEL_FORMAT=yuv420p

# --- Synthesis limits ---
MAX_INPUT_LENGTH=280
MAX_CLIPS_PER_REQUEST=24
JOB_RETENTION_SECONDS=1800
PROCESSING_CONCURRENCY=2

# --- FFmpeg / video processing (Part 04) ---
# Binaries resolved from PATH by default; override for non-standard installs.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Clip duration guards (seconds) and per-job processing timeout.
MIN_CLIP_SECONDS=0.3
MAX_CLIP_SECONDS=12.0
PROCESSING_TIMEOUT_SECONDS=120
# Encode quality/speed. Lower CRF = higher quality/larger file.
FFMPEG_CRF=23
FFMPEG_PRESET=veryfast
# Optional ephemeral scratch directory (defaults to system temp). Always cleaned.
SCRATCH_DIR=
