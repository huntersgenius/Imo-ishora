# IMO-ISHORA frontend configuration (Vite exposes only VITE_-prefixed vars).
# The frontend NEVER holds R2 secrets. It only talks to the backend API.

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000

# Optional demo-mode label shown in the UI.
VITE_DEMO_LABEL=Demo

# Job status polling cadence (milliseconds).
VITE_POLL_INTERVAL_MS=1200

# Stop polling after this long (milliseconds) and show a timeout state.
VITE_POLL_TIMEOUT_MS=120000

# Max input length shown/enforced in the UI. Keep aligned with backend MAX_INPUT_LENGTH.
VITE_MAX_INPUT_LENGTH=280
